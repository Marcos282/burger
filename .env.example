# Modelo de configuração por ambiente. Copie para `.env` e preencha os valores.
# O arquivo `.env` nunca deve ser versionado.

# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Use False em produção.
DJANGO_DEBUG=False
# Lista separada por vírgula. Um ponto inicial libera todos os subdomínios (.exemplo.com).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=master_db
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Painel do Mercado Pago > Suas integrações > Credenciais.
MERCADO_PAGO_ACCESS_KEY=
MERCADO_PAGO_TOKEN=
# Opcional: valida a assinatura dos webhooks recebidos.
MERCADOPAGO_WEBHOOK_SECRET=
